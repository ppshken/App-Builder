# Copy to .env.docker, then edit. Do not copy the development .env.local into the image.
COMPOSE_PROJECT_NAME=nocode
APP_IMAGE=nocode-builder:local
NODE_IMAGE=node:22-bookworm-slim
CADDY_IMAGE=caddy:2-alpine
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_MEMORY_LIMIT=2g
APP_CPUS=2.0
APP_NODE_OPTIONS=--max-old-space-size=1024
# Production only: DNS A/AAAA must point here; ports 80/443 must reach Caddy.
APP_DOMAIN=builder.example.com
ACME_EMAIL=admin@example.com
HTTPS_BIND=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# Optional comma-separated HTTPS origins for Automation webhooks; deny by default.
NOCODE_WEBHOOK_ORIGINS=
